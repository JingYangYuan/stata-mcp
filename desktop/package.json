{
  "name": "stata-mcp-desktop",
  "version": "1.5.1",
  "private": true,
  "description": "Stata MCP Studio — 跨平台（macOS / Windows）本地 Stata MCP 部署、作业报错定位、Help 速查与反循环体检桌面控制台。",
  "license": "MIT",
  "author": "JingYangYuan",
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.mjs",
    "prepare:core": "node scripts/prepare-core.mjs",
    "verify:core": "node scripts/verify-core.mjs",
    "package:win": "node scripts/prepare-core.mjs && node scripts/verify-core.mjs && electron-builder --publish never --win nsis zip --x64",
    "package:mac:arm64": "node scripts/prepare-core.mjs && node scripts/verify-core.mjs && electron-builder --publish never --mac dmg zip --arm64",
    "package:mac:x64": "node scripts/prepare-core.mjs && node scripts/verify-core.mjs && electron-builder --publish never --mac dmg zip --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.jingyangyuan.statamcp",
    "productName": "Stata MCP Studio",
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/stata-mcp-core",
        "to": "stata-mcp-core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Stata-MCP-Studio-${version}-windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Stata-MCP-Studio-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
